{
  "extends": "@vue/tsconfig/tsconfig.json",
  "compilerOptions": {
    // The harness is transpiled to CommonJS and run by plain node, so the
    // bundler-only resolution settings the base config turns on must come back
    // off: node needs real `require` calls and extensionless specifiers.
    "module": "CommonJS",
    "moduleResolution": "Node",
    "verbatimModuleSyntax": false,
    "allowImportingTsExtensions": false,
    "outDir": "./.verify-out",
    "rootDir": ".",
    "types": ["node"],
    "noEmit": false,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.verify.tsbuildinfo"
  },
  "include": ["tests/sync/verify.ts", "tests/sync/compat.ts"]
}
