# Copy to .env.local for local builds. Netlify reads the same names from
# Site settings -> Environment variables. Never commit a real .env file.

# Sentry DSN for error reporting. Leave empty to disable it. Only production
# builds (vite build) report, and only when this is set. Format:
# https://<public-key>@<org>.ingest.sentry.io/<project-id>
VITE_SENTRY_DSN=

# Release name attached to error reports, for example a version or commit SHA.
# Optional; leave empty to report without a release.
VITE_APP_VERSION=
